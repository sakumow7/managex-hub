# Local portfolio demo with SQLite. Use a Neon URL on Render.
DATABASE_URL=sqlite:///./portfolio.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_ENABLED=true
DEMO_MINUTES=60
DEMO_MAX_WORKSPACES=30
DEMO_MAX_MUTATIONS=100
# For separate hosted frontend/API origins, allow only the frontend's exact URL.
CORS_ORIGINS=[]
